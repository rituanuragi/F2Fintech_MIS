{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": false, "skipLibCheck": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true, "noEmit": true, "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "server"]
}
